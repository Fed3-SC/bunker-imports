# ============================================================
# BUNKER IMPORTS — Variables de Entorno
# Copiar este archivo como .env y completar con valores reales
# NUNCA subir el archivo .env a GitHub
# ============================================================

# Puerto del servidor (por defecto 3000)
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# URI de conexión a MongoDB (reemplazar con tu URI real)
MONGODB_URI=mongodb://localhost:27017/bunker_imports

# URI de MongoDB para tests (base de datos separada)
MONGODB_TEST_URI=mongodb://localhost:27017/bunker_imports_test

# Clave secreta para JWT (mínimo 32 caracteres, usar una clave aleatoria fuerte)
JWT_SECRET=CAMBIAR_POR_CLAVE_SECRETA_FUERTE_DE_AL_MENOS_32_CARACTERES

# Tiempo de expiración del token JWT (ej: 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# Credenciales del administrador inicial (para el script de seed)
ADMIN_INITIAL_NAME=Admin Bunker
ADMIN_INITIAL_EMAIL=admin@bunkerimports.com
ADMIN_INITIAL_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA

# Descuento por transferencia bancaria (porcentaje, ej: 10)
TRANSFER_DISCOUNT_PERCENT=10

# Umbral de envío gratis en pesos (ej: 120000)
FREE_SHIPPING_THRESHOLD=120000
